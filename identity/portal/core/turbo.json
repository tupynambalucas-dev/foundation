{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/identity/apps/**/*.json", "$TURBO_ROOT$/identity/apps/**/description.md"],
      "outputs": ["src/registry.generated.ts"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/identity/apps/**/*.json", "$TURBO_ROOT$/identity/apps/**/description.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/identity/apps/**/*.json", "$TURBO_ROOT$/identity/apps/**/description.md"]
    }
  }
}
