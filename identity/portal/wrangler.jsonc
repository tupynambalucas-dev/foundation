{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tupynambalucas-apps-portal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "apps.tupynambalucas.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
