{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tupynambalucas-apps-portal",
  "main": "src/worker.ts",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/webhooks/*", "/api/*"]
  },
  "routes": [
    {
      "pattern": "apps.tupynambalucas.dev",
      "custom_domain": true
    }
  ],
  "workflows": [
    {
      "name": "pr-gate-evaluator",
      "binding": "PR_GATE_WORKFLOW",
      "class_name": "PrGateEvaluatorWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
