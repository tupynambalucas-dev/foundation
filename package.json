{
  "name": "@tupynambalucas-dev/workstation",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise workstation monorepo hosting sovereign Linux distributions, GitHub extensions, and host virtualization engines.",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "license": "Apache-2.0",
  "homepage": "https://docs.tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas-dev/workstation.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "tl:build": "pnpm --filter @tupynambalucas-dev/workstation-gh-tl build",
    "tl:test": "pnpm --filter @tupynambalucas-dev/workstation-gh-tl test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:tooling-stack",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "eslint": "catalog:tooling-stack",
    "eslint-config-prettier": "catalog:tooling-stack",
    "eslint-plugin-prettier": "catalog:tooling-stack",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack"
  }
}
