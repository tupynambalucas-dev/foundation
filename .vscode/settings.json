{
  "search.useIgnoreFiles": false,
  "search.useGlobalIgnoreFiles": false,
  "search.useParentIgnoreFiles": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": true
  },
  "files.exclude": {
    "**/.git": false
  },
  "gopls": {
    "ui.navigation.importShortcut": "Both",
    "directoryFilters": [
      "-node_modules",
      "-dist",
      "+tools/github/extensions/gh-tl"
    ]
  }
}
